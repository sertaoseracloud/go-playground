    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@nanostores/react": "^2.0.1",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "astro": "^7.4.5",
    "codemirror": "^6.0.2",
    "nanostores": "^1.5.5",
