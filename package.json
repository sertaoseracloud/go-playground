    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "badges": "node scripts/gerar-badges.mjs",
    "lint": "eslint .",
    "comuns": "node scripts/comuns.mjs",
    "conferir-build": "node scripts/conferir-build.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@nanostores/react": "2.0.1",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "astro": "7.3.5",
    "codemirror": "^6.0.2",
    "nanostores": "1.5.4",
    "qrcode-generator": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
