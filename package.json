{
  "name": "go-playground",
  "version": "1.11.0",
  "description": "DivergeGo: Go no navegador, com acessibilidade para pessoas cegas, surdas e neurodivergentes",
  "scripts": {
    "predev": "node scripts/construir-go-wasm.mjs --se-faltar --opcional",
    "dev": "vite --port 5178 --host",
    "prebuild": "node scripts/construir-go-wasm.mjs --se-faltar",
    "build": "vite build",
    "preview": "vite preview --port 4178 --strictPort",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "badges": "node scripts/gerar-badges.mjs",
    "lint": "eslint .",
    "comuns": "node scripts/comuns.mjs",
    "comuns:copiar": "node scripts/comuns.mjs copiar",
    "comuns:comparar": "node scripts/comuns.mjs comparar",
    "conferir-build": "vite build && npm run test",
    "validar:exercicios": "node scripts/validar-exercicios.mjs",
    "go:wasm": "node scripts/construir-go-wasm.mjs",
    "validar:wasm": "node scripts/validar-go-wasm.mjs"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "@sertaoseracloud/playground-ui": "github:sertaoseracloud/playground-ui#v0.1.1",
    "codemirror": "^6.0.2",
    "pixi.js": "8.22.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "@lhci/cli": {
      "basic-ftp": "^6.2.3",
      "extract-zip": "^2.0.1",
      "tmp": "^0.2.7",
      "uuid": "^14.0.3",
      "sprintf-js": "^1.1.3",
      "js-yaml": "^5.5.0",
      "inquirer": "^14.2.3",
      "proxy-agent": "^8.0.2",
      "lighthouse": "^13.5.0",
      "@puppeteer/browsers": "^3.2.5",
      "puppeteer-core": "^25.14.0"
    }
  }
}
