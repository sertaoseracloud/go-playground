    "comuns": "node scripts/comuns.mjs",
    "comuns:copiar": "node scripts/comuns.mjs copiar",
    "comuns:comparar": "node scripts/comuns.mjs comparar",
    "conferir-build": "npm run build && npm run test"
  },
  "type": "module",
  "dependencies": {
