{
  "name": "go-playground",
  "version": "1.11.0",
  "description": "DivergeGo: Go no navegador, com acessibilidade para pessoas cegas, surdas e neurodivergentes",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/conferir-segredo.mjs",
    "preview": "astro preview",
    "check": "astro check",
