---
// Página dinâmica de exercício/lição: gera uma rota /p/<id>/ para cada item da trilha.
// O editor, terminal e testes são montados por ilhas React ou scripts legados no cliente.
import Base from '../../layouts/Base.astro';
import ExercicioGo from '../../islands/ExercicioGo';
import MaisAcoes from '../../islands/MaisAcoes';
import CelebracaoConclusao from '../../islands/CelebracaoConclusao';
import { todosOsItens, vizinhosDe, semHtml } from '../../lib/conteudo';
import { url } from '../../lib/rotas';

export function getStaticPaths() {
 return todosOsItens.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { anterior, proximo } = vizinhosDe(item.id);
const titulo = `${item.titulo} — DivergeGo`;
const descricao = semHtml(item.resumo || item.enunciado) || `Exercício ${item.titulo} da trilha de Go.`;
---

<Base titulo={titulo} descricao={descricao}>
 <article class="exercicio" data-item-id={item.id} data-item-tipo={item.tipo}>
 <header class="exercicio-header">
 <p class="breadcrumb">
 {item.modulo && <span class="modulo">{item.modulo}</span>}
 <span class="tipo">{item.tipo === 'licao' ? '📖 Lição' : '🧩 Problema'}</span>
 </p>
 <h1>{item.titulo}</h1>
 {item.dificuldade && <span class={`dificuldade ${item.dificuldade}`}>{item.dificuldade}</span>}
 </header>

 {item.resumo && <section class="resumo" set:html={item.resumo} />}
 {item.enunciado && <section class="enunciado" set:html={item.enunciado} />}
 {item.dica && <details class="dica"><summary>Precisa de uma dica?</summary><p>{item.dica}</p></details>}

 <ExercicioGo client:visible item={item} />
 <CelebracaoConclusao client:visible itemId={item.id} />
 <MaisAcoes client:visible acoes={[]} />

 <nav class="vizinhos" aria-label="Navegação entre exercícios">
 {anterior ? (
 <a href={url.exercicio(anterior.id)} class="anterior" rel="prev">
 ‹ <span>{anterior.titulo}</span>
 </a>
 ) : <span />}
 {proximo ? (
 <a href={url.exercicio(proximo.id)} class="proximo" rel="next">
 <span>{proximo.titulo}</span> ›
 </a>
 ) : <span />}
 </nav>
 </article>
</Base>